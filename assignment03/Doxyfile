DOXYFILE_ENCODING      = UTF-8

PROJECT_NAME           = "Scientific Computing I - Assignment 3"
PROJECT_NUMBER         = "Winter 2025/2026"
OUTPUT_DIRECTORY       = doxygen

# Scan both exercise folders (as required by the pattern)
INPUT                  = excersice1 exercsice2
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.md

# Exclude build artifacts (so you don't accidentally document binaries/objects)
EXCLUDE_PATTERNS       = */*.o */exercise1 */exercise2 */main

