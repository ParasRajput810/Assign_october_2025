# Output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Source browsing (optional but useful)
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

# Quiet
QUIET                  = NO